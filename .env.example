# Copy to .env only for local use; never commit real secrets.
TERRAVIA_DATABASE=var/terravia.sqlite3
TERRAVIA_CONTROL_KEY=replace-with-a-random-secret-at-least-32-characters
TERRAVIA_COOKIE_SECURE=false
# Optional local Ollama service. Leave model empty to disable AI explanations.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
